# Kopieer dit bestand naar worker/.env.local en vul het in. .env.local komt nooit in Git.

# Map voor de ruwe opnames (standaard: C:\Users\<jij>\FamilieMK-YouTube)
# WORKER_DATA_DIR=D:\YouTube-opnames

# Wachtrij in het Supabase-project van KIVOXEL Studio (NIET het familieproject). Zonder deze twee werkt de werker alleen lokaal.
# De service-sleutel staat in Supabase onder Project Settings > API Keys (secret). Deel hem met niemand.
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=

# Alleen deze adressen mogen de werker gebruiken (komma's ertussen)
# WORKER_ALLOWED_ORIGINS=http://localhost:3200,https://kivoxel-studio.vercel.app

# Alleen nodig als FFmpeg niet vanzelf gevonden wordt
# FFMPEG_PATH=
# FFPROBE_PATH=

# Analysedienst (pakket 52): Gemini, alleen de betaalde laag (akkoord Milan 11-11-2026, plafond € 5 per maand,
# in te stellen in YouTube Studio). Sleutel uit Google AI Studio, van een project met facturering aan.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite

# Stem (pakket 53): Google Cloud Text-to-Speech, Chirp 3 HD, alleen het gratis deel (1 miljoen tekens per maand;
# de werker stopt zelf bij 900.000). Zet in Google Cloud Console de Cloud Text-to-Speech API aan en maak een
# API-sleutel die alleen voor die API geldt. Zonder sleutel worden montages gemaakt zonder stem.
# GOOGLE_TTS_API_KEY=

# Tijdens een montage vraagt de werker Windows om de pc wakker te houden (zoals een videospeler). Zet op 0 om dat uit te zetten.
# WORKER_KEEP_AWAKE=1

# YouTube-koppeling (fase D). OAuth-client van het soort "Desktop-app" uit Google Cloud, project "Familie MK YouTube".
# Zie docs/youtube-koppeling.md, hoofdstuk 3. Zelf invullen in worker/.env.local, nooit in de chat of in Git.
# YOUTUBE_CLIENT_ID=
# YOUTUBE_CLIENT_SECRET=
# Sleutel om de YouTube-tokens op deze pc te versleutelen (de werker maakt er een als hij ontbreekt).
# YT_TOKEN_KEY=

# Inbox-map (fase 2): zet een opname in deze map en de werker pakt hem op zodra het kopiëren klaar is.
# Standaard C:\Users\<jij>\KIVOXEL\inbox. Mislukte bestanden gaan naar inbox\_fout, dubbele naar inbox\_dubbel.
# KIVOXEL_INBOX_DIR=D:\KIVOXEL\inbox
# Zet op 0 om de inbox-map uit te zetten.
# KIVOXEL_INBOX=1
